/* ---------- اگر می‌خوای اوورلی نیمه‌شفاف روی گرادینت برای خوانایی باشه ---------- */
.bg-with-overlay {
  position: relative;
  background: linear-gradient(135deg, var(--g1) 0%, var(--g2) 50%, var(--g3) 100%);
  min-height: 100vh;
  overflow: hidden;
}
.bg-with-overlay::before{
  content: "";
  position: absolute;
  inset: 0;
  background: var(--overlay);
  pointer-events: none;
}

/* استفاده در HTML:
   <div class="bg-with-overlay">
     <!-- محتوا اینجا -->
   </div>
*/

/* ---------- گرادینت عمودی مناسب موبایل / hero (top → bottom) ---------- */
.hero-gradient-vertical {
  background: linear-gradient(180deg, var(--g1) 0%, var(--g2) 45%, var(--g3) 100%);
  min-height: 60vh; /* یا هر ارتفاع دلخواه برای Hero */
}

/* ---------- گرادینت رادیال (اگر بخوای فوکوس از گوشه باشه) ---------- */
.hero-gradient-radial {
  background: radial-gradient(circle at top left, var(--g3) 0%, var(--g2) 45%, var(--g1) 100%);
  min-height: 60vh;
}

/* ---------- نمونه کلاس برای کارت/فرم (که روی گرادینت قرار می‌گیره) ---------- */
.form-card {
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(7,12,34,0.28);
  padding: 40px;
  color: #111; /* متن داخل کارت */
  max-width: 720px;
  width: 100%;
}

/* ---------- نکات ریسپانسیو: برای موبایل جهت گرادینت عمودی استفاده کن ---------- */
@media (max-width: 768px){
  body {
    background: linear-gradient(180deg, var(--g1) 0%, var(--g2) 45%, var(--g3) 100%);
  }
}

















































